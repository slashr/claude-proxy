#!/usr/bin/env bash
set -euo pipefail

hook_input=$(cat)
prompt=$(printf '%s' "$hook_input" | jq -er '.prompt')
codex_session_id=$(printf '%s' "$hook_input" | jq -er '.session_id')
# Codex provides its workspace as `cwd`. Keep compatibility with older hook
# payloads and fall back to the hook process's current directory when it is absent.
working_dir=$(printf '%s' "$hook_input" | jq -r '.cwd // .working_directory // .workspace_root // empty')
if [[ -z "$working_dir" || ! -d "$working_dir" ]]; then
  working_dir=$(pwd -P)
fi
plugin_data_dir=${PLUGIN_DATA:-${CLAUDE_PLUGIN_DATA:-}}
if [[ -z "$plugin_data_dir" ]]; then
  printf '%s\n' 'Claude proxy requires PLUGIN_DATA or CLAUDE_PLUGIN_DATA.' >&2
  exit 1
fi
plugin_root=${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}
if [[ -z "$plugin_root" ]]; then
  printf '%s\n' 'Claude proxy requires PLUGIN_ROOT or CLAUDE_PLUGIN_ROOT.' >&2
  exit 1
fi
plugin_root=${plugin_root#file://}
session_dir="$plugin_data_dir/claude-sessions"
session_file="$session_dir/$codex_session_id"
session_lock="$session_dir/$codex_session_id.lock"
session_codex_only_file="$session_dir/$codex_session_id.codex-only"
activity_dir="$plugin_data_dir/claude-activity"
job_dir="$plugin_data_dir/claude-jobs"
umask 077
mkdir -p "$session_dir"
mkdir -p "$activity_dir"
mkdir -p "$job_dir"

# GPT-Live sends work as a realtime-delegation wrapper. It keeps the voice
# conversation in transcript_delta but assigns a new Codex session ID to each
# delegated task, so session-file state cannot carry the user's routing choice.
# Inspect the transcript instead and let the latest spoken control command win.
voice_routing=""
if [[ "$prompt" == *"<realtime_delegation>"* && "$prompt" == *"<transcript_delta>"* && "$prompt" == *"</transcript_delta>"* ]]; then
  voice_transcript=${prompt#*<transcript_delta>}
  voice_transcript=${voice_transcript%%</transcript_delta>*}
  while IFS= read -r voice_line; do
    if [[ "$voice_line" =~ ^[[:space:]]*[Uu]ser:[[:space:]]*(.*)$ ]]; then
      voice_user_text=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')
      if [[ "$voice_user_text" == *"use codex only for this chat"* || "$voice_user_text" == *"use codex only for this task"* || "$voice_user_text" == *"use codex only for this thread"* ]]; then
        voice_routing="codex"
      elif [[ "$voice_user_text" == *"resume claude proxy"* || "$voice_user_text" == *"use claude proxy"* || "$voice_user_text" == *"use claude again"* ]]; then
        voice_routing="claude"
      fi
    fi
  done <<<"$voice_transcript"
fi

if [[ "$voice_routing" == "codex" ]]; then
  : >"$session_file.bypass"
  jq -n '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:"Claude Proxy is bypassed because the latest GPT-Live routing command is Codex-only. Say `resume Claude proxy` in Voice to re-enable Claude for later delegated tasks."}}'
  exit 0
fi

# Typed tasks use the current Codex session ID, so they can keep a conventional
# session-scoped Codex-only marker.
prompt_for_routing=$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/[.!?]+$//')
case "$prompt_for_routing" in
  "resume claude proxy"|"use claude proxy"|"use claude again")
    rm -f "$session_codex_only_file"
    : >"$session_file.bypass"
    jq -n '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:"Claude Proxy is enabled again for this task. The next normal prompt will start a Claude worker."}}'
    exit 0
    ;;
  "use codex only for this chat"|"use codex only for this task"|"use codex only for this thread"|"/codex thread")
    : >"$session_codex_only_file"
    : >"$session_file.bypass"
    jq -n '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:"This task is now in Codex-only mode. Claude Proxy will remain bypassed for later prompts until the user says `resume Claude proxy`."}}'
    exit 0
    ;;
esac

if [[ -f "$session_codex_only_file" ]]; then
  : >"$session_file.bypass"
  jq -n '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:"Claude Proxy is bypassed because this task is in Codex-only mode. The user can say `resume Claude proxy` to re-enable it."}}'
  exit 0
fi

# An explicit user opt-out applies only to this prompt; the next normal prompt
# returns to Claude routing. The exact /codex marker is the predictable
# app-friendly form.
if [[ "$prompt" =~ (^|[[:space:]])/codex([[:space:]]|$) || "$prompt" =~ [Dd][Oo][[:space:]]+[Nn][Oo][Tt][[:space:]]+[Uu][Ss][Ee][[:space:]]+[Cc]laude ]]; then
  : >"$session_file.bypass"
  jq -n '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:"Claude proxy bypassed for this prompt because the user explicitly asked not to use Claude."}}'
  exit 0
fi

rm -f "$session_file.bypass"
turn_id=$(printf '%s' "$hook_input" | jq -r '.turn_id // empty')
job_id="${codex_session_id}-${turn_id:-$(date +%s)}"
job_file="$job_dir/$job_id.json"
launch_label="com.claude-proxy.worker.${job_id}.${RANDOM}"

# File changes need an explicit user request. Keep read-only investigations,
# explanations, and reviews in read mode; use write mode for implementation and
# PR workflows. The worker runs headlessly with Claude Auto Mode in both modes;
# Claude's classifier remains responsible for deciding which actions are allowed.
worker_mode="read"
prompt_for_mode=$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')
if [[ "$prompt_for_mode" =~ (^|[^[:alpha:]])(implement|build|create|add|update|modify|edit|fix|refactor|write|change|install|enable|disable|configure|generate|test|probe|commit|push|publish)([^[:alpha:]]|$) \
  || "$prompt_for_mode" =~ (open|submit)[[:space:]]+(a[[:space:]]+)?(pull[[:space:]]+request|pr) ]]; then
  worker_mode="write"
fi

jq -n \
  --arg job_id "$job_id" \
  --arg codex_session_id "$codex_session_id" \
  --arg prompt "$prompt" \
  --arg working_dir "$working_dir" \
  --arg worker_mode "$worker_mode" \
  --arg launch_label "$launch_label" \
  --argjson started_at "$(date +%s)" \
  '{job_id:$job_id,codex_session_id:$codex_session_id,prompt:$prompt,working_dir:$working_dir,worker_mode:$worker_mode,launch_label:$launch_label,state:"queued",started_at:$started_at}' >"$job_file"

# One Claude session must have one active worker. Concurrent --resume calls
# race the session transcript and can leave the activity card permanently stale.
if ! mkdir "$session_lock" 2>/dev/null; then
  active_job=$(cat "$session_lock/job_id" 2>/dev/null || true)
  active_file="$job_dir/$active_job.json"
  active_state=$(jq -r '.state // empty' "$active_file" 2>/dev/null || true)
  if [[ "$active_state" == "queued" || "$active_state" == "running" ]]; then
    rm -f "$job_file"
    jq -n --arg job_id "$active_job" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:("A Claude worker is already running for this task. Do not start another worker; call `claude_is_working` with job_id `" + $job_id + "`. Do not call `show_claude_worker` unless the user explicitly asks to inspect activity. If it returns state `running` with progress_message, relay that message once as concise user-facing progress, then call `claude_is_working` again. When it reaches `completed`, `failed`, or `cancelled`, synthesize worker_result or acknowledge cancellation.")}}'
    exit 0
  fi
  rm -f "$session_lock/job_id"
  rmdir "$session_lock" 2>/dev/null || true
  mkdir "$session_lock"
fi
printf '%s\n' "$job_id" >"$session_lock/job_id"

if ! /bin/launchctl submit -l "$launch_label" \
  -o "$job_dir/$job_id.launch.log" \
  -e "$job_dir/$job_id.launch.err.log" \
  -- /usr/bin/env "HOME=${HOME:-}" "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" \
  /bin/bash "$plugin_root/scripts/run-claude-worker" "$job_file" "$plugin_data_dir"; then
  rm -f "$session_lock/job_id" "$job_file"
  rmdir "$session_lock" 2>/dev/null || true
  exit 1
fi

jq -n --arg job_id "$job_id" --arg worker_mode "$worker_mode" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:("A Claude worker was started asynchronously in " + $worker_mode + " mode. Call `claude_is_working` with job_id `" + $job_id + "`. Do not call `show_claude_worker` unless the user explicitly asks to inspect activity; keeping it hidden avoids a large widget. If it returns state `running` with progress_message, relay that message once as concise user-facing progress (without tool inputs, raw thinking, or generic waiting text), then call `claude_is_working` again. When it reaches `completed`, `failed`, or `cancelled`, synthesize worker_result or acknowledge cancellation in Codex voice. Do not use direct Codex shell commands for the task. The activity card may show safe status and tool names, never private reasoning or raw tool inputs.")}}'

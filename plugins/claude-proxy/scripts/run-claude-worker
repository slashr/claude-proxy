#!/usr/bin/env bash
set -euo pipefail

job_file=${1:?job file is required}
plugin_data_dir=${2:?plugin data directory is required}
job_file_dir=$(cd "$(dirname "$job_file")" && pwd -P)
job_file="$job_file_dir/$(basename "$job_file")"
plugin_data_dir=$(cd "$plugin_data_dir" && pwd -P)

umask 077
session_dir="$plugin_data_dir/claude-sessions"
activity_dir="$plugin_data_dir/claude-activity"
mkdir -p "$session_dir" "$activity_dir"

job_id=$(jq -er '.job_id' "$job_file")
codex_session_id=$(jq -er '.codex_session_id' "$job_file")
prompt=$(jq -er '.prompt' "$job_file")
working_dir=$(jq -r '.working_dir // empty' "$job_file")
context_file=$(jq -r '.context_file // empty' "$job_file")
worker_mode=$(jq -r '.worker_mode // "read"' "$job_file")
resume_session=$(jq -r '.resume_session // false' "$job_file")
activity_file="$activity_dir/$job_id.jsonl"
cancel_file="$job_file.cancelled"
session_file="$session_dir/$codex_session_id"
if [[ -z "$context_file" ]]; then context_file="$session_dir/$codex_session_id.context.json"; fi
session_lock="$session_dir/$codex_session_id.lock"
launch_label=$(jq -r '.launch_label // empty' "$job_file")
# Recorded in every job update so the MCP server can tell a slow worker apart
# from a dead one without imposing a runtime limit. `$$` stays the main script's
# PID even when write_job runs from the heartbeat subshell.
worker_pid=$$
job_terminal=0
claude_pid=""
tee_pid=""
heartbeat_pid=""
caffeinate_pid=""
startup_watchdog_pid=""
stream_dir=""
stream_fifo=""
last_attempt_startup_stalled=false
last_attempt_retryable_failure=false
startup_stall_attempts=0
startup_stall_timeout_seconds=150

cleanup_lock() {
  if [[ $(cat "$session_lock/job_id" 2>/dev/null || true) == "$job_id" ]]; then
    rm -f "$session_lock/job_id"
    rmdir "$session_lock" 2>/dev/null || true
  fi
}

case "$worker_mode" in
  read) permission_mode="auto" ;;
  write) permission_mode="auto" ;;
  *)
    printf '%s\n' "Unsupported Claude worker mode: $worker_mode" >&2
    exit 2
    ;;
esac

write_job() {
  local state=$1
  local detail=${2:-}
  local result=${3:-}
  local claude_session=${4:-}
  local summary=${5:-}
  local exit_code=${6:-null}
  local finished_at=null
  local temporary
  temporary=$(mktemp "$job_file.tmp.XXXXXX")
  if [[ "$state" == "completed" || "$state" == "failed" || "$state" == "cancelled" ]]; then
    finished_at=$(date +%s)
    job_terminal=1
  fi
  jq -n \
    --arg job_id "$job_id" \
    --arg codex_session_id "$codex_session_id" \
    --arg activity_file "$activity_file" \
    --arg working_dir "$working_dir" \
    --arg context_file "$context_file" \
    --arg worker_mode "$worker_mode" \
    --argjson resume_session "$resume_session" \
    --argjson worker_pid "$worker_pid" \
    --arg launch_label "$launch_label" \
    --arg state "$state" \
    --arg detail "$detail" \
    --arg result "$result" \
    --arg claude_session_id "$claude_session" \
    --arg tool_summary "$summary" \
    --argjson started_at "$(jq -r '.started_at' "$job_file")" \
    --argjson updated_at "$(date +%s)" \
    --argjson finished_at "$finished_at" \
    --argjson exit_code "$exit_code" \
    '{job_id:$job_id,codex_session_id:$codex_session_id,activity_file:$activity_file,working_dir:$working_dir,context_file:$context_file,worker_mode:$worker_mode,resume_session:$resume_session,worker_pid:$worker_pid,launch_label:$launch_label,state:$state,detail:$detail,result:$result,claude_session_id:$claude_session_id,tool_summary:$tool_summary,started_at:$started_at,updated_at:$updated_at,finished_at:$finished_at,exit_code:$exit_code}' >"$temporary"
  mv "$temporary" "$job_file"
}

stop_heartbeat() {
  if [[ -n "$heartbeat_pid" ]]; then kill -TERM "$heartbeat_pid" 2>/dev/null || true; wait "$heartbeat_pid" 2>/dev/null || true; fi
  heartbeat_pid=""
}

stop_startup_watchdog() {
  if [[ -n "$startup_watchdog_pid" ]]; then
    kill -TERM "$startup_watchdog_pid" 2>/dev/null || true
    wait "$startup_watchdog_pid" 2>/dev/null || true
  fi
  startup_watchdog_pid=""
}

start_startup_watchdog() {
  local attempt_file=$1
  local stalled_file=$2
  local observed_claude_pid=$claude_pid

  # Claude Code should write its first stream event almost immediately. A
  # running CLI that emits nothing is a startup hang, not long-running work.
  # This guard deliberately stops watching after the first byte: real tasks
  # remain unlimited regardless of how long they take after startup.
  (
    trap 'exit 0' TERM INT
    sleep "$startup_stall_timeout_seconds"
    [[ -f "$cancel_file" || -s "$attempt_file" ]] && exit 0
    if kill -0 "$observed_claude_pid" 2>/dev/null; then
      : >"$stalled_file"
      kill -TERM "$observed_claude_pid" 2>/dev/null || true
      # Claude's Node process can ignore TERM while stuck in startup. Give it
      # a brief graceful window, then force the attempt to end so the parent
      # runner can record the stall and make its bounded retry.
      sleep 5
      if kill -0 "$observed_claude_pid" 2>/dev/null; then
        kill -KILL "$observed_claude_pid" 2>/dev/null || true
      fi
    fi
  ) &
  startup_watchdog_pid=$!
}

start_caffeinate() {
  # launchctl workers do not inherit an interactive power assertion. Prevent
  # idle sleep only while this job is active; caffeinate exits with this script
  # even if cleanup is interrupted.
  if [[ -x /usr/bin/caffeinate ]]; then
    /usr/bin/caffeinate -i -w "$$" >/dev/null 2>&1 &
    caffeinate_pid=$!
  fi
}

stop_caffeinate() {
  if [[ -n "$caffeinate_pid" ]]; then
    kill -TERM "$caffeinate_pid" 2>/dev/null || true
    wait "$caffeinate_pid" 2>/dev/null || true
  fi
  caffeinate_pid=""
}

start_heartbeat() {
  (
    trap - TERM INT EXIT
    while kill -0 "$claude_pid" 2>/dev/null; do
      sleep 5
      [[ -f "$cancel_file" ]] && exit 0
      kill -0 "$claude_pid" 2>/dev/null || exit 0
      write_job "running" "Claude worker is working." "" "" "$(safe_summary)" || true
    done
  ) &
  heartbeat_pid=$!
}

cleanup_stream() {
  if [[ -n "$stream_fifo" ]]; then rm -f "$stream_fifo"; fi
  if [[ -n "$stream_dir" ]]; then rmdir "$stream_dir" 2>/dev/null || true; fi
  stream_fifo=""
  stream_dir=""
  claude_pid=""
  tee_pid=""
}

cancel_worker() {
  trap - TERM INT
  stop_startup_watchdog
  stop_heartbeat
  stop_caffeinate
  if [[ -n "$claude_pid" ]]; then kill -TERM "$claude_pid" 2>/dev/null || true; fi
  if [[ -n "$claude_pid" ]]; then wait "$claude_pid" 2>/dev/null || true; fi
  if [[ -n "$tee_pid" ]]; then wait "$tee_pid" 2>/dev/null || true; fi
  cleanup_stream
  write_job "cancelled" "Cancelled from ChatGPT." "" "" "No Claude tool calls reported." 143 || true
  cleanup_lock
  trap - EXIT
  exit 143
}

finalize_unexpected_exit() {
  local status=$?
  stop_startup_watchdog
  stop_heartbeat
  stop_caffeinate
  if [[ $job_terminal -eq 0 ]]; then
    if [[ -f "$cancel_file" ]]; then
      write_job "cancelled" "Cancelled from ChatGPT." "" "" "No Claude tool calls reported." 143 || true
    else
      write_job "failed" "Claude worker exited unexpectedly (status $status)." "" "" "No Claude tool calls reported." "$status" || true
    fi
  fi
  cleanup_lock
  trap - EXIT
  exit "$status"
}
trap finalize_unexpected_exit EXIT
trap cancel_worker TERM INT

# launchctl workers otherwise start in `/`, which prevents Claude Code from
# resolving the task's project memory and instruction files. Do not silently
# fall back there: a missing workspace is a failed job, not a valid project.
if [[ -z "$working_dir" || ! -d "$working_dir" ]]; then
  write_job "failed" "Claude worker workspace is missing or unavailable." "" "" "No Claude tool calls reported." 2
  exit 2
fi
working_dir=$(cd "$working_dir" && pwd -P)
cd "$working_dir"

git_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
git_head=$(git rev-parse HEAD 2>/dev/null || true)

build_worker_prompt() {
  local prior_prompt prior_result handoff
  if [[ ! -s "$context_file" ]]; then
    printf '%s' "$prompt"
    return
  fi
  prior_prompt=$(jq -r --arg working_dir "$working_dir" 'select(.working_dir == $working_dir) | .last_user_prompt // empty' "$context_file" 2>/dev/null || true)
  prior_result=$(jq -r --arg working_dir "$working_dir" 'select(.working_dir == $working_dir) | .last_worker_result // empty' "$context_file" 2>/dev/null || true)
  if [[ -z "$prior_prompt" && -z "$prior_result" ]]; then
    printf '%s' "$prompt"
    return
  fi
  # The handoff is intentionally bounded and only contains user-visible task
  # state, never Codex private reasoning or the raw Claude tool transcript.
  prior_prompt=${prior_prompt:0:2000}
  prior_result=${prior_result:0:6000}
  printf -v handoff '<codex_handoff>\nWorkspace: %s\nGit branch: %s\nGit HEAD: %s\nPrevious user request:\n%s\n\nPrevious worker result:\n%s\n</codex_handoff>\n\n' "$working_dir" "${git_branch:-unknown}" "${git_head:-unknown}" "$prior_prompt" "$prior_result"
  printf '%s%s' "$handoff" "$prompt"
}

write_context() {
  local temporary
  temporary=$(mktemp "$context_file.tmp.XXXXXX")
  jq -n \
    --arg codex_session_id "$codex_session_id" \
    --arg working_dir "$working_dir" \
    --arg git_branch "$git_branch" \
    --arg git_head "$git_head" \
    --arg last_user_prompt "$prompt" \
    --arg last_worker_result "${claude_result:0:6000}" \
    --argjson updated_at "$(date +%s)" \
    '{codex_session_id:$codex_session_id,working_dir:$working_dir,git_branch:$git_branch,git_head:$git_head,last_user_prompt:$last_user_prompt,last_worker_result:$last_worker_result,updated_at:$updated_at}' >"$temporary"
  mv "$temporary" "$context_file"
}

safe_summary() {
  jq -rs '
    [ .[]
      | select(.type == "assistant")
      | .message.content[]?
      | select(.type == "tool_use")
      | .name
    ]
    | group_by(.)
    | map("\(.[0]): \(length)")
    | if length == 0 then "No Claude tool calls reported." else join(", ") end
  ' "$activity_file" 2>/dev/null || printf 'Tool activity could not be summarized.'
}

: >"$activity_file"
write_job "running" "Claude worker is starting in $worker_mode mode."
start_caffeinate
if [[ -f "$cancel_file" ]]; then
  write_job "cancelled" "Cancelled from ChatGPT." "" "" "No Claude tool calls reported." 143
  exit 143
fi

claude_bin=$(command -v claude || true)
if [[ -z "$claude_bin" && -x "${HOME:-}/.local/bin/claude" ]]; then
  claude_bin="${HOME}/.local/bin/claude"
fi
if [[ -z "$claude_bin" ]]; then
  write_job "failed" "Claude CLI is unavailable to the worker." "" "" "No Claude tool calls reported." 127
  exit 127
fi

# User-configured Claude MCP servers can block headless CLI startup before it
# emits even its initial stream event. The worker needs Claude's local tools,
# not those inherited servers, so start with an explicitly empty MCP config.
base_claude_args=(-p --verbose --output-format stream-json --permission-mode "$permission_mode" --model claude-opus-5 --mcp-config '{"mcpServers":{}}' --strict-mcp-config)
worker_prompt=$(build_worker_prompt)

run_claude() {
  local -a args=("$@")
  local attempt_file stalled_file attempt_has_result attempt_is_error
  attempt_file=$(mktemp "$activity_dir/${job_id}.attempt.XXXXXX")
  stalled_file="$attempt_file.startup-stalled"
  stream_dir=$(mktemp -d "$activity_dir/${job_id}.stream.XXXXXX")
  stream_fifo="$stream_dir/output"
  mkfifo "$stream_fifo"
  tee "$attempt_file" <"$stream_fifo" >/dev/null &
  tee_pid=$!
  set +e
  CLAUDE_WORKER_MODE="$worker_mode" "$claude_bin" "${args[@]}" "$worker_prompt" >"$stream_fifo" 2>&1 &
  claude_pid=$!
  start_startup_watchdog "$attempt_file" "$stalled_file"
  start_heartbeat
  wait "$claude_pid"
  claude_status=$?
  claude_pid=""
  stop_startup_watchdog
  stop_heartbeat
  wait "$tee_pid"
  tee_pid=""
  cat "$attempt_file" >>"$activity_file"
  attempt_has_result=$(jq -se 'any(.[]; .type == "result")' "$attempt_file" 2>/dev/null || printf false)
  attempt_is_error=$(jq -r 'select(.type == "result") | .is_error // false' "$attempt_file" 2>/dev/null | tail -1)
  if [[ -f "$stalled_file" ]]; then
    last_attempt_startup_stalled=true
    last_attempt_retryable_failure=true
    startup_stall_attempts=$((startup_stall_attempts + 1))
  else
    last_attempt_startup_stalled=false
    last_attempt_retryable_failure=false
  fi
  if [[ "$last_attempt_startup_stalled" != true && ( $claude_status -ne 0 || "$attempt_has_result" != "true" || "$attempt_is_error" == "true" ) ]]; then
    if grep -Eiq 'overloaded|connection closed mid-response|connection (reset|timed out)|ECONNRESET|temporarily unavailable' "$attempt_file"; then
      last_attempt_retryable_failure=true
    fi
  fi
  rm -f "$attempt_file" "$stalled_file"
  set -e
  cleanup_stream
}

run_claude_with_retries() {
  local -a args=("$@")
  local retry_attempt=0
  local delay_seconds
  local max_retries=3

  while true; do
    run_claude "${args[@]}"
    [[ -f "$cancel_file" ]] && return
    if [[ "$last_attempt_retryable_failure" != true || $retry_attempt -ge $max_retries ]]; then
      return
    fi
    retry_attempt=$((retry_attempt + 1))
    delay_seconds=$((20 * (2 ** (retry_attempt - 1))))
    if [[ "$last_attempt_startup_stalled" == true ]]; then
      write_job "running" "Claude worker emitted no startup activity; retrying in ${delay_seconds}s (attempt ${retry_attempt}/${max_retries})." "" "" "$(safe_summary)" || true
    else
      write_job "running" "Claude provider is overloaded; retrying in ${delay_seconds}s (attempt ${retry_attempt}/${max_retries})." "" "" "$(safe_summary)" || true
    fi
    sleep "$delay_seconds"
  done
}

claude_args=("${base_claude_args[@]}")
if [[ "$resume_session" == "true" && -s "$session_file" ]]; then
  claude_args+=(--resume "$(<"$session_file")")
  run_claude_with_retries "${claude_args[@]}"
  if [[ $claude_status -ne 0 ]] && grep -Eiq 'No conversation found with session ID|session[^[:alnum:]]+(not found|does not exist)' "$activity_file"; then
    rm -f "$session_file"
    claude_args=("${base_claude_args[@]}")
    run_claude_with_retries "${claude_args[@]}"
  fi
else
  run_claude_with_retries "${claude_args[@]}"
fi

if [[ -f "$cancel_file" ]]; then
  write_job "cancelled" "Cancelled from ChatGPT." "" "" "$(safe_summary)" 143
  exit 143
fi

summary=$(safe_summary)
result_event=$(jq -se '[.[] | select(.type == "result")] | last' "$activity_file" 2>/dev/null || true)
if [[ $claude_status -ne 0 || -z "$result_event" || "$result_event" == "null" ]]; then
  failure_status=$claude_status
  if [[ $failure_status -eq 0 ]]; then failure_status=1; fi
  retry_error=$(jq -r 'select(.type == "system" and .subtype == "api_retry") | .error' "$activity_file" 2>/dev/null | tail -1)
  if [[ $startup_stall_attempts -gt 0 ]]; then
    write_job "failed" "Claude worker did not emit startup activity after automatic retries." "" "" "$summary" "$failure_status"
  elif [[ -n "$retry_error" ]]; then
    write_job "failed" "Claude worker failed after provider retries: $retry_error." "" "" "$summary" "$failure_status"
  else
    write_job "failed" "Claude worker exited before returning a result." "" "" "$summary" "$failure_status"
  fi
  exit "$failure_status"
fi

if [[ $(jq -r '.is_error // false' <<<"$result_event") == "true" ]]; then
  write_job "failed" "Claude returned an error result." "" "" "$summary" 1
  exit 1
fi

claude_result=$(jq -er '.result' <<<"$result_event")
claude_session_id=$(jq -er '.session_id' <<<"$result_event")
printf '%s\n' "$claude_session_id" >"$session_file"
write_context
write_job "completed" "Claude worker completed." "$claude_result" "$claude_session_id" "$summary"
